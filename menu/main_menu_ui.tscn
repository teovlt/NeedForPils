[gd_scene format=3]

[ext_resource type="Script" path="res://menu/main_menu_ui.gd" id="1_ui"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.06, 0.07, 0.1, 0.8)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(1, 0.72, 0.1, 1)
corner_radius_top_left = 40
corner_radius_top_right = 40
corner_radius_bottom_right = 40
corner_radius_bottom_left = 40

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_normal"]
bg_color = Color(0.16, 0.18, 0.24, 1)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_hover"]
bg_color = Color(1, 0.72, 0.1, 1)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_pressed"]
bg_color = Color(0.85, 0.55, 0.05, 1)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[sub_resource type="Theme" id="Theme_menu"]
Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(0.06, 0.07, 0.1, 1)
Button/colors/font_pressed_color = Color(0.06, 0.07, 0.1, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/font_sizes/font_size = 72
Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_btn_normal")

[node name="MainMenuUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_menu")
script = ExtResource("1_ui")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 120
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 120
theme_override_constants/margin_bottom = 80

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 40
alignment = 1

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.72, 0.1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 16
theme_override_font_sizes/font_size = 140
text = "NEED FOR PILS"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.82, 0.88, 1)
theme_override_font_sizes/font_size = 44
text = "Visez avec la manette et appuyez sur la gâchette"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2

[node name="MainButtons" type="VBoxContainer" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 30

[node name="PlayButton" type="Button" parent="Panel/Margin/VBox/MainButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
focus_mode = 0
text = "JOUER À DEUX"

[node name="SoloButton" type="Button" parent="Panel/Margin/VBox/MainButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
focus_mode = 0
text = "JOUER SEUL"

[node name="QuitButton" type="Button" parent="Panel/Margin/VBox/MainButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
focus_mode = 0
text = "QUITTER"

[node name="Waiting" type="VBoxContainer" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 40

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox/Waiting"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 250)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 56
text = "En attente de l'autre joueur..."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="CancelButton" type="Button" parent="Panel/Margin/VBox/Waiting"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
focus_mode = 0
text = "ANNULER"
